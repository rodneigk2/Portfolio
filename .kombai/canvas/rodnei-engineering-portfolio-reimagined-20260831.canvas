ormo regras, dados e rotinas difíceis de organizar em produtos que uma equipe consegue usar, entender e manter.\n                    </p>\n                    <div class=\"mt-9 flex flex-col gap-3 sm:flex-row\" data-kid=\"1-2-1-1-1-4\">\n                        <a class=\"button primary-button inline-flex items-center justify-center gap-3 bg-[#b9e8f5] px-5 py-3.5 text-sm font-semibold text-[#0b0e13]\" data-kid=\"1-2-1-1-1-4-1\" href=\"#mirai\">\n                            Ver o case MIRAI\n                            <i class=\"arrow ti ti-arrow-down-right text-[16px]\" data-kid=\"1-2-1-1-1-4-1-1\">\n                            </i>\n                        </a>\n                        <a class=\"button ghost-button inline-flex items-center justify-center gap-3 border border-[#344052] px-5 py-3.5 text-sm font-semibold text-[#d6dee8]\" data-kid=\"1-2-1-1-1-4-2\" href=\"https://wa.me/5517988364203\" rel=\"noopener noreferrer\" target=\"_blank\">\n                            Falar sobre um projeto\n                            <i class=\"arrow ti ti-arrow-up-right text-[16px]\" data-kid=\"1-2-1-1-1-4-2-1\">\n                            </i>\n                        </a>\n                    </div>\n                    <div class=\"mt-14 grid max-w-[34rem] grid-cols-3 border-y rule py-5\" data-kid=\"1-2-1-1-1-5\">\n                        <div class=\"pr-4\" data-kid=\"1-2-1-1-1-5-1\">\n                            <p class=\"label text-[#667286]\" data-kid=\"1-2-1-1-1-5-1-1\">\n                                case ativo\n                            </p>\n                            <p class=\"mt-2 text-sm font-semibold text-[#e3e9f0]\" data-kid=\"1-2-1-1-1-5-1-2\">\n                                MIRAI\n                            </p>\n                        </div>\n                        <div class=\"border-l rule px-4\" data-kid=\"1-2-1-1-1-5-2\">\n                            <p class=\"label text-[#667286]\" data-kid=\"1-2-1-1-1-5-2-1\">\n                                camada\n                            </p>\n                            <p class=\"mt-2 text-sm font-semibold text-[#e3e9f0]\" data-kid=\"1-2-1-1-1-5-2-2\">\n                                Dash + dados\n                            </p>\n                        </div>\n                        <div class=\"border-l rule pl-4\" data-kid=\"1-2-1-1-1-5-3\">\n                            <p class=\"label text-[#667286]\" data-kid=\"1-2-1-1-1-5-3-1\">\n                                base\n                            </p>\n                            <p class=\"mt-2 text-sm font-semibold text-[#e3e9f0]\" data-kid=\"1-2-1-1-1-5-3-2\">\n                                PostgreSQL\n                            </p>\n                        </div>\n                    </div>\n                </div>\n                <figure class=\"hero-media border rule bg-[#11161e] p-3\" data-kid=\"1-2-1-1-2\">\n                    <div class=\"flex items-center justify-between border-b rule px-2 pb-3 pt-1\" data-kid=\"1-2-1-1-2-1\">\n                        <div class=\"flex items-center gap-3\" data-kid=\"1-2-1-1-2-1-1\">\n                            <span class=\"flex gap-1.5\" data-kid=\"1-2-1-1-2-1-1-1\">\n                                <span class=\"h-2 w-2 rounded-full bg-[#b9e8f5]\" data-kid=\"1-2-1-1-2-1-1-1-1\">\n                                </span>\n                                <span class=\"h-2 w-2 rounded-full bg-[#56647a]\" data-kid=\"1-2-1-1-2-1-1-1-2\">\n                                </span>\n                                <span class=\"h-2 w-2 rounded-full bg-[#344052]\" data-kid=\"1-2-1-1-2-1-1-1-3\">\n                                </span>\n                            </span>\n                            <span class=\"label text-[#8491a4]\" data-kid=\"1-2-1-1-2-1-1-2\">\n                                mirai / financeiro / dashboard\n                            </span>\n                        </div>\n                        <span class=\"label hidden items-center gap-2 text-[#b9e8f5] sm:flex\" data-kid=\"1-2-1-1-2-1-2\">\n                            <span class=\"h-1.5 w-1.5 rounded-full bg-[#b9e8f5]\" data-kid=\"1-2-1-1-2-1-2-1\">\n                            </span>\n                            interface real\n                        </span>\n                    </div>\n                    <div class=\"mt-3 overflow-hidden border rule bg-[#080b10]\" data-kid=\"1-2-1-1-2-2\">\n                        <img alt=\"Dashboard financeiro desktop do MIRAI\" class=\"block h-auto w-full object-cover object-top\" data-kid=\"1-2-1-1-2-2-1\" decoding=\"async\" height=\"800\" loading=\"lazy\" src=\"/api/local/images/public/projects/mirai/fluxo-caixa-desktop.jpeg\" width=\"1400\"/>\n                    </div>\n                    <figcaption class=\"flex flex-col gap-3 border-t rule px-2 pb-1 pt-4 sm:flex-row sm:items-center sm:justify-between\" data-kid=\"1-2-1-1-2-3\">\n                        <span class=\"label text-[#667286]\" data-kid=\"1-2-1-1-2-3-1\">\n                            fluxo de caixa / visão operacional\n                        </span>\n                        <a class=\"label fade-link text-[#b9e8f5]\" data-kid=\"1-2-1-1-2-3-2\" href=\"#mirai\">\n                            abrir case\n                            <i class=\"ti ti-arrow-up-right ml-1\" data-kid=\"1-2-1-1-2-3-2-1\">\n                            </i>\n                        </a>\n                    </figcaption>\n                </figure>\n            </div>\n        </section>\n        <section class=\"border-y rule bg-[#0f151e]\" data-kid=\"1-2-2\" id=\"mirai\">\n            <div class=\"mx-auto max-w-[1240px] px-6 py-28 lg:px-8 lg:py-36\" data-kid=\"1-2-2-1\">\n                <div class=\"flex flex-col justify-between gap-6 border-b rule pb-9 lg:flex-row lg:items-end\" data-kid=\"1-2-2-1-1\">\n                    <div data-kid=\"1-2-2-1-1-1\">\n                        <p class=\"label flex items-center gap-3 text-[#b9e8f5]\" data-kid=\"1-2-2-1-1-1-1\">\n                            <span class=\"h-px w-8 bg-[#83d7ec]\" data-kid=\"1-2-2-1-1-1-1-1\">\n                            </span>\n                            01 / case study\n                        </p>\n                        <h2 class=\"mt-6 max-w-[11ch] text-[clamp(3rem,5vw,5.8rem)] font-semibold leading-[.92] tracking-[-.075em]\" data-kid=\"1-2-2-1-1-1-2\">\n                            MIRAI, financeiro sem ruído.\n                        </h2>\n                    </div>\n                    <p class=\"max-w-[31rem] text-[17px] leading-8 text-[#9aa6b6]\" data-kid=\"1-2-2-1-1-2\">\n                        Uma interface para ler o caixa, enxergar risco e acompanhar a operação sem transformar o dado em mais uma barreira.\n                    </p>\n                </div>\n                <div class=\"mt-14 grid items-start gap-12 lg:grid-cols-[.36fr_.64fr] lg:gap-16\" data-kid=\"1-2-2-1-2\">\n                    <aside class=\"lg:sticky lg:top-24\" data-kid=\"1-2-2-1-2-1\">\n                        <div class=\"border-l-2 border-[#83d7ec] pl-5\" data-kid=\"1-2-2-1-2-1-1\">\n                            <p class=\"label text-[#b9e8f5]\" data-kid=\"1-2-2-1-2-1-1-1\">\n                                o problema\n                            </p>\n                            <p class=\"mt-3 max-w-[18rem] text-2xl font-semibold leading-tight tracking-[-.04em] text-[#f1f4f8]\" data-kid=\"1-2-2-1-2-1-1-2\">\n                                Clareza para decidir. Base para crescer.\n                            </p>\n                        </div>\n                        <div class=\"mt-10 divide-y rule border-y rule\" data-kid=\"1-2-2-1-2-1-2\">\n                            <div class=\"grid grid-cols-[5.4rem_1fr] gap-4 py-5\" data-kid=\"1-2-2-1-2-1-2-1\">\n                                <span class=\"label text-[#667286]\" data-kid=\"1-2-2-1-2-1-2-1-1\">\n                                    resultado\n                                </span>\n                                <p class=\"text-sm leading-6 text-[#c9d2de]\" data-kid=\"1-2-2-1-2-1-2-1-2\">\n                                    Leitura histórica, projeções e simulação em um único fluxo.\n                                </p>\n                            </div>\n                            <div class=\"grid grid-cols-[5.4rem_1fr] gap-4 py-5\" data-kid=\"1-2-2-1-2-1-2-2\">\n                                <span class=\"label text-[#667286]\" data-kid=\"1-2-2-1-2-1-2-2-1\">\n                                    operação\n                                </span>\n                                <p class=\"text-sm leading-6 text-[#c9d2de]\" data-kid=\"1-2-2-1-2-1-2-2-2\">\n                                    Cobranças, relacionamento e acompanhamento comercial organizados.\n                                </p>\n                            </div>\n                            <div class=\"grid grid-cols-[5.4rem_1fr] gap-4 py-5\" data-kid=\"1-2-2-1-2-1-2-3\">\n                                <span class=\"label text-[#667286]\" data-kid=\"1-2-2-1-2-1-2-3-1\">\n                                    base\n                                </span>\n                                <p class=\"text-sm leading-6 text-[#c9d2de]\" data-kid=\"1-2-2-1-2-1-2-3-2\">\n                                    Legado, PostgreSQL e regras de negócio sem esconder a complexidade.\n                                </p>\n                            </div>\n                        </div>\n                        <div class=\"mt-8 border-t rule pt-5\" data-kid=\"1-2-2-1-2-1-3\">\n                            <p class=\"label text-[#667286]\" data-kid=\"1-2-2-1-2-1-3-1\">\n                                stack do case\n                            </p>\n                            <p class=\"mt-3 text-sm leading-7 text-[#e3e9f0]\" data-kid=\"1-2-2-1-2-1-3-2\">\n                                Python · Dash · Plotly · PostgreSQL · Firebird · Redis · Docker\n                            </p>\n                        </div>\n                    </aside>\n                    <div data-kid=\"1-2-2-1-2-2\">\n                        <figure class=\"case-media border rule bg-[#080b10] p-3\" data-kid=\"1-2-2-1-2-2-1\">\n                            <img alt=\"Tela principal do dashboard financeiro MIRAI\" class=\"block h-auto w-full\" data-kid=\"1-2-2-1-2-2-1-1\" decoding=\"async\" height=\"800\" loading=\"lazy\" src=\"/api/local/images/public/projects/mirai/fluxo-caixa-desktop.jpeg\" width=\"1400\"/>\n                            <figcaption class=\"flex flex-col gap-2 border-t rule px-2 pb-1 pt-4 sm:flex-row sm:items-center sm:justify-between\" data-kid=\"1-2-2-1-2-2-1-2\">\n                                <span class=\"label text-[#667286]\" data-kid=\"1-2-2-1-2-2-1-2-1\">\n                                    tela principal / diagnóstico, saldo e projeção\n                                </span>\n                                <span class=\"label text-[#b9e8f5]\" data-kid=\"1-2-2-1-2-2-1-2-2\">\n                                    interface real · 01\n                                </span>\n                            </figcaption>\n                        </figure>\n                        <div class=\"flex flex-col gap-4 border-b rule py-6 sm:flex-row sm:items-center sm:justify-between\" data-kid=\"1-2-2-1-2-2-2\">\n                            <p class=\"max-w-[32rem] text-sm leading-6 text-[#9aa6b6]\" data-kid=\"1-2-2-1-2-2-2-1\">\n                                A prova fica no centro da narrativa: uma tela real, um contexto real e uma ação que abre o demo sem abandonar o case.\n                            </p>\n                            <button aria-expanded=\"false\" class=\"button ghost-button inline-flex shrink-0 items-center justify-center gap-2 border border-[#344052] px-4 py-3 text-sm font-semibold text-[#b9e8f5]\" data-dynamic=\"true\" data-kid=\"1-2-2-1-2-2-2-2\" data-name=\"demo trigger button\" data-reason=\"aria attribute, button label, and scroll behavior triggered by script\" id=\"demo-toggle\" type=\"button\">\n                                <i class=\"ti ti-player-play\" data-kid=\"1-2-2-1-2-2-2-2-1\">\n                                </i>\n                                <span data-dynamic=\"true\" data-kid=\"1-2-2-1-2-2-2-2-2\" data-name=\"demo button label text\" data-reason=\"text replaced by demo toggle script\" id=\"demo-label\">\n                                    Assistir demo\n                                </span>\n                            </button>\n                        </div>\n                        <div class=\"demo-panel border rule bg-[#080b10] p-3\" data-dynamic=\"true\" data-kid=\"1-2-2-1-2-2-3\" data-name=\"demo video panel\" data-open=\"false\" data-reason=\"data-open attribute toggled by demo script\" id=\"demo-panel\">\n                            <video aria-label=\"Demo em vídeo do MIRAI\" class=\"w-full\" controls=\"\" controlslist=\"nodownload\" data-kid=\"1-2-2-1-2-2-3-1\" playsinline=\"\" poster=\"/api/local/images/public/projects/mirai/fluxo-caixa-desktop.jpeg\" preload=\"metadata\" src=\"/api/local/images/public/projects/mirai/mirai-demo.mp4\">\n                            </video>\n                            <p class=\"label mt-3 text-[#667286]\" data-kid=\"1-2-2-1-2-2-3-2\">\n                                demo do MIRAI / fluxo de caixa em uso\n                            </p>\n                        </div>\n                        <div class=\"mt-14 border-t rule pt-6\" data-kid=\"1-2-2-1-2-2-4\">\n                            <div class=\"flex items-end justify-between gap-4\" data-kid=\"1-2-2-1-2-2-4-1\">\n                                <div data-kid=\"1-2-2-1-2-2-4-1-1\">\n                                    <p class=\"label text-[#b9e8f5]\" data-kid=\"1-2-2-1-2-2-4-1-1-1\">\n                                        material de apoio\n                                    </p>\n                                    <h3 class=\"mt-3 text-2xl font-semibold tracking-[-.04em] text-[#f1f4f8]\" data-kid=\"1-2-2-1-2-2-4-1-1-2\">\n                                        Fluxos mobile, sem esconder a tela principal.\n                                    </h3>\n                                </div>\n                                <span class=\"label hidden text-[#667286] sm:block\" data-kid=\"1-2-2-1-2-2-4-1-2\">\n                                    03 views\n                                </span>\n                            </div>\n                            <div class=\"mt-6 grid gap-4 sm:grid-cols-3\" data-kid=\"1-2-2-1-2-2-4-2\">\n                                <figure data-kid=\"1-2-2-1-2-2-4-2-1\">\n                                    <div class=\"overflow-hidden border rule bg-[#080b10]\" data-kid=\"1-2-2-1-2-2-4-2-1-1\">\n                                        <img alt=\"Tela mobile de fluxo de caixa do MIRAI\" class=\"h-72 w-full object-cover object-top\" data-kid=\"1-2-2-1-2-2-4-2-1-1-1\" decoding=\"async\" height=\"640\" loading=\"lazy\" src=\"/api/local/images/public/projects/mirai/mobile-fluxo-caixa.jpeg\" width=\"320\"/>\n                                    </div>\n                                    <figcaption class=\"label mt-3 text-[#758196]\" data-kid=\"1-2-2-1-2-2-4-2-1-2\">\n                                        fluxo de caixa\n                                    </figcaption>\n                                </figure>\n                                <figure data-kid=\"1-2-2-1-2-2-4-2-2\">\n                                    <div class=\"overflow-hidden border rule bg-[#080b10]\" data-kid=\"1-2-2-1-2-2-4-2-2-1\">\n                                        <img alt=\"Tela mobile do menu operacional do MIRAI\" class=\"h-72 w-full object-cover object-top\" data-kid=\"1-2-2-1-2-2-4-2-2-1-1\" decoding=\"async\" height=\"640\" loading=\"lazy\" src=\"/api/local/images/public/projects/mirai/mobile-menu.jpeg\" width=\"320\"/>\n                                    </div>\n                                    <figcaption class=\"label mt-3 text-[#758196]\" data-kid=\"1-2-2-1-2-2-4-2-2-2\">\n                                        menu operacional\n                                    </figcaption>\n                                </figure>\n                                <figure data-kid=\"1-2-2-1-2-2-4-2-3\">\n                                    <div class=\"overflow-hidden border rule bg-[#080b10]\" data-kid=\"1-2-2-1-2-2-4-2-3-1\">\n                                        <img alt=\"Tela mobile de marketing do MIRAI\" class=\"h-72 w-full object-cover object-top\" data-kid=\"1-2-2-1-2-2-4-2-3-1-1\" decoding=\"async\" height=\"640\" loading=\"lazy\" src=\"/api/local/images/public/projects/mirai/mobile-marketing.jpeg\" width=\"320\"/>\n                                    </div>\n                                    <figcaption class=\"label mt-3 text-[#758196]\" data-kid=\"1-2-2-1-2-2-4-2-3-2\">\n                                        marketing\n                                    </figcaption>\n                                </figure>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <section class=\"border-b rule bg-[#0b0e13]\" data-kid=\"1-2-3\" id=\"aep\">\n            <div class=\"mx-auto grid max-w-[1240px] gap-14 px-6 py-28 lg:grid-cols-[.37fr_.63fr] lg:gap-20 lg:px-8 lg:py-36\" data-kid=\"1-2-3-1\">\n                <div data-kid=\"1-2-3-1-1\">\n                    <p class=\"label flex items-center gap-3 text-[#b9e8f5]\" data-kid=\"1-2-3-1-1-1\">\n                        <span class=\"h-px w-8 bg-[#83d7ec]\" data-kid=\"1-2-3-1-1-1-1\">\n                        </span>\n                        02 / framework autoral\n                    </p>\n                    <h2 class=\"mt-6 max-w-[9ch] text-[clamp(3.1rem,5vw,5.6rem)] font-semibold leading-[.91] tracking-[-.075em]\" data-kid=\"1-2-3-1-1-2\">\n                        Limite antes da ação.\n                    </h2>\n                    <p class=\"mt-8 max-w-[28rem] text-[17px] leading-8 text-[#9aa6b6]\" data-kid=\"1-2-3-1-1-3\">\n                        O AI Execution Protocol organiza o caminho antes da ferramenta: risco, contexto, capacidade, validação e entrega.\n                    </p>\n                    <a class=\"fade-link mt-8 inline-flex items-center gap-2 border-b border-[#83d7ec] pb-2 text-sm font-semibold text-[#b9e8f5]\" data-kid=\"1-2-3-1-1-4\" href=\"https://github.com/rodneigk2/ai-execution-protocol\" rel=\"noopener noreferrer\" target=\"_blank\">\n                        Ler no GitHub\n                        <i class=\"ti ti-arrow-up-right\" data-kid=\"1-2-3-1-1-4-1\">\n                        </i>\n                    </a>\n                </div>\n                <div class=\"border-t rule\" data-kid=\"1-2-3-1-2\">\n                    <div class=\"grid grid-cols-[5.3rem_1fr] gap-5 border-b rule py-4\" data-kid=\"1-2-3-1-2-1\">\n                        <span class=\"label text-[#667286]\" data-kid=\"1-2-3-1-2-1-1\">\n                            ação\n                        </span>\n                        <span class=\"label text-[#667286]\" data-kid=\"1-2-3-1-2-1-2\">\n                            resposta do AEP\n                        </span>\n                    </div>\n                    <div class=\"grid gap-3 border-b rule py-6 sm:grid-cols-[5.3rem_1fr_1fr] sm:gap-5\" data-kid=\"1-2-3-1-2-2\">\n                        <span class=\"label text-[#b9e8f5]\" data-kid=\"1-2-3-1-2-2-1\">\n                            01\n                        </span>\n                        <p class=\"text-base font-semibold\" data-kid=\"1-2-3-1-2-2-2\">\n                            Alterar arquivo\n                        </p>\n                        <p class=\"text-sm leading-6 text-[#9aa6b6]\" data-kid=\"1-2-3-1-2-2-3\">\n                            Classifica risco antes de tocar no código.\n                        </p>\n                    </div>\n                    <div class=\"grid gap-3 border-b rule py-6 sm:grid-cols-[5.3rem_1fr_1fr] sm:gap-5\" data-kid=\"1-2-3-1-2-3\">\n                        <span class=\"label text-[#b9e8f5]\" data-kid=\"1-2-3-1-2-3-1\">\n                            02\n                        </span>\n                        <p class=\"text-base font-semibold\" data-kid=\"1-2-3-1-2-3-2\">\n                            Carregar contexto\n                        </p>\n                        <p class=\"text-sm leading-6 text-[#9aa6b6]\" data-kid=\"1-2-3-1-2-3-3\">\n                            Entrega só o que a rota precisa saber.\n                        </p>\n                    </div>\n                    <div class=\"grid gap-3 border-b rule py-6 sm:grid-cols-[5.3rem_1fr_1fr] sm:gap-5\" data-kid=\"1-2-3-1-2-4\">\n                        <span class=\"label text-[#b9e8f5]\" data-kid=\"1-2-3-1-2-4-1\">\n                            03\n                        </span>\n                        <p class=\"text-base font-semibold\" data-kid=\"1-2-3-1-2-4-2\">\n                            Chamar ferramenta\n                        </p>\n                        <p class=\"text-sm leading-6 text-[#9aa6b6]\" data-kid=\"1-2-3-1-2-4-3\">\n                            Seleciona capacidade e permissão antes do uso.\n                        </p>\n                    </div>\n                    <div class=\"grid gap-3 border-b rule py-6 sm:grid-cols-[5.3rem_1fr_1fr] sm:gap-5\" data-kid=\"1-2-3-1-2-5\">\n                        <span class=\"label text-[#b9e8f5]\" data-kid=\"1-2-3-1-2-5-1\">\n                            04\n                        </span>\n                        <p class=\"text-base font-semibold\" data-kid=\"1-2-3-1-2-5-2\">\n                            Declarar término\n                        </p>\n                        <p class=\"text-sm leading-6 text-[#9aa6b6]\" data-kid=\"1-2-3-1-2-5-3\">\n                            Exige validação e evidência antes da entrega.\n                        </p>\n                    </div>\n                    <div class=\"grid gap-3 py-6 sm:grid-cols-[5.3rem_1fr_1fr] sm:gap-5\" data-kid=\"1-2-3-1-2-6\">\n                        <span class=\"label text-[#b9e8f5]\" data-kid=\"1-2-3-1-2-6-1\">\n                            05\n                        </span>\n                        <p class=\"text-base font-semibold\" data-kid=\"1-2-3-1-2-6-2\">\n                            Publicar resultado\n                        </p>\n                        <p class=\"text-sm leading-6 text-[#9aa6b6]\" data-kid=\"1-2-3-1-2-6-3\">\n                            Declara limites e risco residual sem prometer demais.\n                        </p>\n                    </div>\n                    <div class=\"flex flex-wrap items-center gap-x-5 gap-y-2 border-t rule pt-5\" data-kid=\"1-2-3-1-2-7\">\n                        <span class=\"label text-[#667286]\" data-kid=\"1-2-3-1-2-7-1\">\n                            appendix / stack\n                        </span>\n                        <p class=\"text-sm text-[#c9d2de]\" data-kid=\"1-2-3-1-2-7-2\">\n                            Python · JavaScript · MCP · CLI · YAML · Gateways · Traces\n                        </p>\n                        <span class=\"label text-[#667286]\" data-kid=\"1-2-3-1-2-7-3\">\n                            v0.9.0 · alpha\n                        </span>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <section class=\"border-b rule bg-[#11161e]\" data-kid=\"1-2-4\" id=\"method\">\n            <div class=\"mx-auto max-w-[1240px] px-6 py-28 lg:px-8 lg:py-36\" data-kid=\"1-2-4-1\">\n                <div class=\"flex flex-col justify-between gap-6 border-b rule pb-9 lg:flex-row lg:items-end\" data-kid=\"1-2-4-1-1\">\n                    <div data-kid=\"1-2-4-1-1-1\">\n                        <p class=\"label flex items-center gap-3 text-[#b9e8f5]\" data-kid=\"1-2-4-1-1-1-1\">\n                            <span class=\"h-px w-8 bg-[#83d7ec]\" data-kid=\"1-2-4-1-1-1-1-1\">\n                            </span>\n                            03 / método & stack\n                        </p>\n                        <h2 class=\"mt-6 max-w-[10ch] text-[clamp(3.1rem,5vw,5.7rem)] font-semibold leading-[.91] tracking-[-.075em]\" data-kid=\"1-2-4-1-1-1-2\">\n                            Escolher pela função.\n                        </h2>\n                    </div>\n                    <p class=\"max-w-[32rem] text-[17px] leading-8 text-[#9aa6b6]\" data-kid=\"1-2-4-1-1-2\">\n                        A tecnologia entra depois do problema. O método organiza o caminho para a entrega ser entendida, usada e mantida.\n                    </p>\n                </div>\n                <div class=\"mt-12 grid gap-14 lg:grid-cols-[.5fr_.5fr] lg:gap-20\" data-kid=\"1-2-4-1-2\">\n                    <div class=\"border-l-2 border-[#83d7ec] pl-6\" data-kid=\"1-2-4-1-2-1\">\n                        <div class=\"border-b rule pb-7\" data-kid=\"1-2-4-1-2-1-1\">\n                            <p class=\"label text-[#b9e8f5]\" data-kid=\"1-2-4-1-2-1-1-1\">\n                                01 / descobrir\n                            </p>\n                            <h3 class=\"mt-3 text-2xl font-semibold tracking-[-.04em]\" data-kid=\"1-2-4-1-2-1-1-2\">\n                                Mapear o fluxo real\n                            </h3>\n                            <p class=\"mt-3 text-sm leading-6 text-[#9aa6b6]\" data-kid=\"1-2-4-1-2-1-1-3\">\n                                Entender rotina, regra e decisão antes de desenhar tela.\n                            </p>\n                        </div>\n                        <div class=\"border-b rule py-7\" data-kid=\"1-2-4-1-2-1-2\">\n                            <p class=\"label text-[#b9e8f5]\" data-kid=\"1-2-4-1-2-1-2-1\">\n                                02 / escolher\n                            </p>\n                            <h3 class=\"mt-3 text-2xl font-semibold tracking-[-.04em]\" data-kid=\"1-2-4-1-2-1-2-2\">\n                                Tecnologia por função\n                            </h3>\n                            <p class=\"mt-3 text-sm leading-6 text-[#9aa6b6]\" data-kid=\"1-2-4-1-2-1-2-3\">\n                                A stack serve o problema, não o contrário.\n                            </p>\n                        </div>\n                        <div class=\"border-b rule py-7\" data-kid=\"1-2-4-1-2-1-3\">\n                            <p class=\"label text-[#b9e8f5]\" data-kid=\"1-2-4-1-2-1-3-1\">\n                                03 / construir\n                            </p>\n                            <h3 class=\"mt-3 text-2xl font-semibold tracking-[-.04em]\" data-kid=\"1-2-4-1-2-1-3-2\">\n                                Base pronta para crescer\n                            </h3>\n                            <p class=\"mt-3 text-sm leading-6 text-[#9aa6b6]\" data-kid=\"1-2-4-1-2-1-3-3\">\n                                Dados, integrações e regras organizados para a próxima fase.\n                            </p>\n                        </div>\n                        <div class=\"pt-7\" data-kid=\"1-2-4-1-2-1-4\">\n                            <p class=\"label text-[#b9e8f5]\" data-kid=\"1-2-4-1-2-1-4-1\">\n                                04 / entregar\n                            </p>\n                            <h3 class=\"mt-3 text-2xl font-semibold tracking-[-.04em]\" data-kid=\"1-2-4-1-2-1-4-2\">\n                                Acabamento de produto\n                            </h3>\n                            <p class=\"mt-3 text-sm leading-6 text-[#9aa6b6]\" data-kid=\"1-2-4-1-2-1-4-3\">\n                                A interface precisa passar confiança no uso diário.\n                            </p>\n                        </div>\n                    </div>\n                    <div data-kid=\"1-2-4-1-2-2\">\n                        <div class=\"border-t rule\" data-kid=\"1-2-4-1-2-2-1\">\n                            <div class=\"grid gap-3 border-b rule py-6 sm:grid-cols-[8.5rem_1fr] sm:gap-8\" data-kid=\"1-2-4-1-2-2-1-1\">\n                                <p class=\"label text-[#667286]\" data-kid=\"1-2-4-1-2-2-1-1-1\">\n                                    frontend\n                                </p>\n                                <p class=\"text-lg font-semibold text-[#e3e9f0]\" data-kid=\"1-2-4-1-2-2-1-1-2\">\n                                    React · Next.js · TypeScript · Tailwind\n                                </p>\n                            </div>\n                            <div class=\"grid gap-3 border-b rule py-6 sm:grid-cols-[8.5rem_1fr] sm:gap-8\" data-kid=\"1-2-4-1-2-2-1-2\">\n                                <p class=\"label text-[#667286]\" data-kid=\"1-2-4-1-2-2-1-2-1\">\n                                    dados\n                                </p>\n                                <p class=\"text-lg font-semibold text-[#e3e9f0]\" data-kid=\"1-2-4-1-2-2-1-2-2\">\n                                    Python · PostgreSQL · Redis · SQL\n                                </p>\n                            </div>\n                            <div class=\"grid gap-3 border-b rule py-6 sm:grid-cols-[8.5rem_1fr] sm:gap-8\" data-kid=\"1-2-4-1-2-2-1-3\">\n                                <p class=\"label text-[#667286]\" data-kid=\"1-2-4-1-2-2-1-3-1\">\n                                    operação\n                                </p>\n                                <p class=\"text-lg font-semibold text-[#e3e9f0]\" data-kid=\"1-2-4-1-2-2-1-3-2\">\n                                    Dash · Plotly · APIs · integrações legadas\n                                </p>\n                            </div>\n                            <div class=\"grid gap-3 border-b rule py-6 sm:grid-cols-[8.5rem_1fr] sm:gap-8\" data-kid=\"1-2-4-1-2-2-1-4\">\n                                <p class=\"label text-[#667286]\" data-kid=\"1-2-4-1-2-2-1-4-1\">\n                                    automação\n                                </p>\n                                <p class=\"text-lg font-semibold text-[#e3e9f0]\" data-kid=\"1-2-4-1-2-2-1-4-2\">\n                                    Agentes · gates · traces · validação\n                                </p>\n                            </div>\n                        </div>\n                        <div class=\"mt-12 border-l-2 border-[#83d7ec] pl-5\" data-kid=\"1-2-4-1-2-2-2\">\n                            <p class=\"label text-[#b9e8f5]\" data-kid=\"1-2-4-1-2-2-2-1\">\n                                critério de decisão\n                            </p>\n                            <p class=\"mt-3 max-w-[31rem] text-2xl font-semibold leading-tight tracking-[-.04em] text-[#f1f4f8]\" data-kid=\"1-2-4-1-2-2-2-2\">\n                                O melhor stack é o que deixa a próxima mudança mais simples.\n                            </p>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <section class=\"bg-[#0b0e13]\" data-kid=\"1-2-5\" id=\"contact\">\n            <div class=\"mx-auto max-w-[1240px] px-6 py-28 lg:px-8 lg:py-36\" data-kid=\"1-2-5-1\">\n                <div class=\"grid gap-14 lg:grid-cols-[.56fr_.44fr] lg:gap-24\" data-kid=\"1-2-5-1-1\">\n                    <div data-kid=\"1-2-5-1-1-1\">\n                        <p class=\"label flex items-center gap-3 text-[#b9e8f5]\" data-kid=\"1-2-5-1-1-1-1\">\n                            <span class=\"h-px w-8 bg-[#83d7ec]\" data-kid=\"1-2-5-1-1-1-1-1\">\n                            </span>\n                            04 / próximo passo\n                        </p>\n                        <h2 class=\"mt-6 max-w-[9ch] text-[clamp(3.7rem,6.4vw,7rem)] font-semibold leading-[.86] tracking-[-.08em]\" data-kid=\"1-2-5-1-1-1-2\">\n                            Vamos começar pelo contexto.\n                        </h2>\n                        <p class=\"mt-8 max-w-[29rem] text-[17px] leading-8 text-[#9aa6b6]\" data-kid=\"1-2-5-1-1-1-3\">\n                            Mande o problema. Eu devolvo as primeiras perguntas certas e um caminho claro para começar.\n                        </p>\n                        <div class=\"mt-10 grid max-w-[29rem] grid-cols-2 border-y rule py-5\" data-kid=\"1-2-5-1-1-1-4\">\n                            <div data-kid=\"1-2-5-1-1-1-4-1\">\n                                <p class=\"label text-[#667286]\" data-kid=\"1-2-5-1-1-1-4-1-1\">\n                                    atuação\n                                </p>\n                                <p class=\"mt-2 text-sm font-semibold\" data-kid=\"1-2-5-1-1-1-4-1-2\">\n                                    Remoto / Brasil\n                                </p>\n                            </div>\n                            <div class=\"border-l rule pl-5\" data-kid=\"1-2-5-1-1-1-4-2\">\n                                <p class=\"label text-[#667286]\" data-kid=\"1-2-5-1-1-1-4-2-1\">\n                                    janela\n                                </p>\n                                <p class=\"mt-2 text-sm font-semibold\" data-kid=\"1-2-5-1-1-1-4-2-2\">\n                                    GMT-3 · direto\n                                </p>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"border-t rule\" data-kid=\"1-2-5-1-1-2\">\n                        <a class=\"direct-link fade-link flex items-start justify-between gap-5 border-b rule py-7\" data-kid=\"1-2-5-1-1-2-1\" href=\"https://wa.me/5517988364203\" rel=\"noopener noreferrer\" target=\"_blank\">\n                            <span data-kid=\"1-2-5-1-1-2-1-1\">\n                                <span class=\"label block text-[#b9e8f5]\" data-kid=\"1-2-5-1-1-2-1-1-1\">\n                                    canal 01 / contexto rápido\n                                </span>\n                                <span class=\"mt-3 block text-2xl font-semibold tracking-[-.04em]\" data-kid=\"1-2-5-1-1-2-1-1-2\">\n                                    Falar pelo WhatsApp\n                                </span>\n                            </span>\n                            <i class=\"arrow ti ti-arrow-up-right mt-1 text-[22px] text-[#b9e8f5]\" data-kid=\"1-2-5-1-1-2-1-2\">\n                            </i>\n                        </a>\n                        <a class=\"direct-link fade-link flex items-start justify-between gap-5 border-b rule py-7\" data-kid=\"1-2-5-1-1-2-2\" href=\"mailto:rodneifive34@gmail.com\">\n                            <span data-kid=\"1-2-5-1-1-2-2-1\">\n                                <span class=\"label block text-[#b9e8f5]\" data-kid=\"1-2-5-1-1-2-2-1-1\">\n                                    canal 02 / escopo e referências\n                                </span>\n                                <span class=\"mt-3 block break-all text-2xl font-semibold tracking-[-.04em]\" data-kid=\"1-2-5-1-1-2-2-1-2\">\n                                    Escrever por email\n                                </span>\n                                <span class=\"mt-2 block text-sm text-[#8793a7]\" data-kid=\"1-2-5-1-1-2-2-1-3\">\n                                    rodneifive34@gmail.com\n                                </span>\n                            </span>\n                            <i class=\"arrow ti ti-arrow-up-right mt-1 text-[22px] text-[#b9e8f5]\" data-kid=\"1-2-5-1-1-2-2-2\">\n                            </i>\n                        </a>\n                        <div class=\"mt-7 flex flex-col justify-between gap-4 border rule p-4 sm:flex-row sm:items-center\" data-kid=\"1-2-5-1-1-2-3\">\n                            <div data-kid=\"1-2-5-1-1-2-3-1\">\n                                <p class=\"label text-[#667286]\" data-kid=\"1-2-5-1-1-2-3-1-1\">\n                                    email direto\n                                </p>\n                                <p class=\"mt-2 break-all text-sm text-[#c9d2de]\" data-kid=\"1-2-5-1-1-2-3-1-2\">\n                                    rodneifive34@gmail.com\n                                </p>\n                            </div>\n                            <button aria-label=\"Copiar email\" class=\"button inline-flex min-h-10 shrink-0 items-center justify-center gap-2 border border-[#344052] px-3 font-mono text-[10px] font-medium uppercase tracking-[.14em] text-[#c9d2de] hover:border-[#b9e8f5] hover:text-[#b9e8f5]\" data-dynamic=\"true\" data-kid=\"1-2-5-1-1-2-3-2\" data-name=\"copy email button\" data-reason=\"label text and icon class updated by copy email script\" id=\"copy-email\" type=\"button\">\n                                <i aria-hidden=\"true\" class=\"ti ti-copy text-[15px]\" data-dynamic=\"true\" data-kid=\"1-2-5-1-1-2-3-2-1\" data-name=\"copy email icon\" data-reason=\"icon class changed by copy email script\" id=\"copy-icon\">\n                                </i>\n                                <span data-dynamic=\"true\" data-kid=\"1-2-5-1-1-2-3-2-2\" data-name=\"copy email button label\" data-reason=\"text changed by copy email script\" id=\"copy-label\">\n                                    Copiar\n                                </span>\n                            </button>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </section>\n    </main>\n    <footer class=\"border-t rule\" data-kid=\"1-3\">\n        <div class=\"mx-auto flex max-w-[1240px] flex-col gap-5 px-6 py-8 lg:flex-row lg:items-center lg:justify-between lg:px-8\" data-kid=\"1-3-1\">\n            <div data-kid=\"1-3-1-1\">\n                <p class=\"text-sm font-semibold\" data-kid=\"1-3-1-1-1\">\n                    Rodnei Rodrigo\n                </p>\n                <p class=\"label mt-2 text-[#667286]\" data-kid=\"1-3-1-1-2\">\n                    produtos operacionais / dados / IA\n                </p>\n            </div>\n            <div class=\"flex flex-wrap items-center gap-5\" data-kid=\"1-3-1-2\">\n                <a class=\"label fade-link text-[#8793a7]\" data-kid=\"1-3-1-2-1\" href=\"https://github.com/rodneigk2\" rel=\"noopener noreferrer\" target=\"_blank\">\n                    GitHub\n                </a>\n                <a class=\"label fade-link text-[#8793a7]\" data-kid=\"1-3-1-2-2\" href=\"https://www.linkedin.com/in/rodnei-rodrigo-396396256\" rel=\"noopener noreferrer\" target=\"_blank\">\n                    LinkedIn\n                </a>\n                <a class=\"label fade-link text-[#8793a7]\" data-kid=\"1-3-1-2-3\" href=\"#top\">\n                    Topo\n                    <i class=\"ti ti-arrow-up-right ml-1\" data-kid=\"1-3-1-2-3-1\">\n                    </i>\n                </a>\n            </div>\n        </div>\n    </footer>\n</div>\n<script>\n    const menuToggle = document.getElementById('menu-toggle');\n  const menu = document.getElementById('mobile-menu');\n  const menuIcon = document.getElementById('menu-icon');\n  const setMenu = (open) => { menu.dataset.open = String(open); menuToggle.setAttribute('aria-expanded', String(open)); menuToggle.setAttribute('aria-label', open ? 'Fechar menu' : 'Abrir menu'); menuIcon.className = open ? 'ti ti-x text-[18px]' : 'ti ti-menu-2 text-[18px]'; };\n  menuToggle.addEventListener('click', () => setMenu(menu.dataset.open !== 'true'));\n  document.querySelectorAll('[data-mobile-link]').forEach((link) => link.addEventListener('click', () => setMenu(false)));\n\n  const demoToggle = document.getElementById('demo-toggle');\n  const demoPanel = document.getElementById('demo-panel');\n  const demoLabel = document.getElementById('demo-label');\n  demoToggle.addEventListener('click', () => { const open = demoPanel.dataset.open !== 'true'; demoPanel.dataset.open = String(open); demoToggle.setAttribute('aria-expanded', String(open)); demoLabel.textContent = open ? 'Fechar demo' : 'Assistir demo'; if (open) demoPanel.scrollIntoView({ behavior: 'smooth', block: 'center' }); });\n\n  const copyButton = document.getElementById('copy-email');\n  const copyLabel = document.getElementById('copy-label');\n  const copyIcon = document.getElementById('copy-icon');\n  copyButton.addEventListener('click', async () => { const value = 'rodneifive34@gmail.com'; try { await navigator.clipboard.writeText(value); } catch (error) { const helper = document.createElement('textarea'); helper.value = value; helper.setAttribute('readonly', ''); helper.style.position = 'fixed'; helper.style.opacity = '0'; document.body.appendChild(helper); helper.select(); document.execCommand('copy'); helper.remove(); } copyLabel.textContent = 'Copiado'; copyIcon.className = 'ti ti-check text-[15px]'; window.setTimeout(() => { copyLabel.textContent = 'Copiar'; copyIcon.className = 'ti ti-copy text-[15px]'; }, 1800); });\n</script>\n",
