      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Inter:wght@400;500;600;700;800&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\nhtml { scroll-behavior: smooth; }\nbody { margin: 0; background: #0b0e13; }\n.site { --bg: #0b0e13; --surface: #11161e; --surface-soft: #151c25; --line: rgba(226,235,244,.12); --line-strong: rgba(226,235,244,.2); --text: #f1f4f8; --soft: #c9d2de; --muted: #8d99a9; --quiet: #667286; --accent: #b9e8f5; --accent-strong: #83d7ec; color: var(--text); background: var(--bg); }\n.site ::selection { color: #0b0e13; background: var(--accent); }\n.font-inter { font-family: 'Inter', sans-serif; }\n.font-mono { font-family: 'DM Mono', monospace; }\n.label { font-family: 'DM Mono', monospace; font-size: 10px; line-height: 1.45; letter-spacing: .15em; text-transform: uppercase; }\n.rule { border-color: var(--line); }\n.fade-link { transition: color .3s ease, border-color .3s ease, background-color .3s ease, transform .3s ease; }\n.fade-link:hover { color: var(--accent); }\n.button { transition: color .3s ease, border-color .3s ease, background-color .3s ease, transform .3s ease; }\n.button:hover { transform: translateY(-2px); }\n.primary-button:hover { background: #d8f5fc; }\n.ghost-button:hover { border-color: var(--accent-strong); color: var(--accent); background: rgba(185,232,245,.05); }\n.arrow { transition: transform .3s ease; }\n.fade-link:hover .arrow, .button:hover .arrow { transform: translate(3px,-3px); }\n.mobile-menu { max-height: 0; opacity: 0; overflow: hidden; transition: max-height .35s ease, opacity .25s ease; }\n.mobile-menu[data-open=\"true\"] { max-height: 26rem; opacity: 1; }\n.demo-panel { max-height: 0; opacity: 0; overflow: hidden; transition: max-height .4s ease, opacity .3s ease, margin-top .4s ease; }\n.demo-panel[data-open=\"true\"] { max-height: 48rem; opacity: 1; margin-top: 1.5rem; }\n.hero-media { box-sha